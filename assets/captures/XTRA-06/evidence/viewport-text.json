  "02-program-vb-directives.png": [
    "  1 ' War.vb",
    "  2 ' A simulation of the card game War between two computer players.",
    "  3 ' Written in the style of classic Visual Basic (VB4/VB5, circa 1995-96):",
    "  4 ' one Module, one Sub Main, plain procedural flow, no LINQ, no lambdas,",
    "  5 ' User-Defined Types (Structures) and parallel logic instead of classes.",
    "  6",
    "  7 Option Explicit On",
    "  8 Option Strict On",
    "  9",
    " 10 Module Program",
    " 11",
    " 12     ' A single playing card. Rank runs 2 through 14 (11=Jack, 12=Queen,",
    " 13     ' 13=King, 14=Ace). Suit is kept only for the printout - War does not",
    " 14     ' care about suits.",
    " 15     Structure Card",
    " 16         Dim Rank As Integer",
    " 17         Dim Suit As Char",
    " 18     End Structure",
