    "155     ' remaining cards up by one slot.",
    "156     Function DrawTopCard(ByRef H As Hand) As Card",
    "157         Dim Top As Card",
    "158         Dim i As Integer",
    "159",
    "160         Top = H.Cards(0)",
    "161         For i = 1 To H.Count - 1",
